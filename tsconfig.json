{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",

    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "app/layout.js",
    "lib/getCalculator.js",
    "components/core/StatsGrid.js",
    "components/core/ResultHero.js",
    "components/core/InputsGrid.js",
    "components/core/ExplanationText.js",
    "components/core/DonutBreakdownChart.js",
    "components/core/DataTable.js",
    "components/core/ComparisonMatrix.js",
    "components/core/CalculatorEngine.js",
    "components/core/CalculatorLayout.js",
    "components/core/ArticleBlock.js"
  ],
  "exclude": ["node_modules"]
}
